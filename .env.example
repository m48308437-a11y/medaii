# MedAI Environment Variables

# Database (required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_db?schema=public

# JWT Secret for session signing (required, generate a long random string in production)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# AI Providers (all optional — the app uses a mock medical AI when not configured)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Rate limiting (optional)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
